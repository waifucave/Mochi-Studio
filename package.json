{
  "name": "mochi-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source live-avatar app for models made with Live2D Cubism, built on Mochi2D.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bridge && tsc --noEmit -p desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:browser": "vite build && vitest run --project browser",
    "screenshots": "vite build && vitest run --project browser test/browser/screenshots.test.ts",
    "test:all": "vite build && vitest run",
    "soak": "vite build && tsx scripts/soak.ts",
    "frame-budget": "vite build && tsx scripts/frame-budget.ts",
    "startup": "vite build && node desktop/build.mjs && tsx scripts/startup.ts",
    "check": "npm run format:check && npm run typecheck && npm test",
    "fetch:models": "node scripts/fetch-models.mjs",
    "notices": "node scripts/notices.mjs",
    "fetch:face-model": "node scripts/fetch-models.mjs face",
    "fetch:hand-model": "node scripts/fetch-models.mjs hand",
    "fetch:spout": "node scripts/fetch-spout.mjs",
    "build:spout": "node-gyp rebuild --directory native/spout",
    "build:v4l2": "node-gyp rebuild --directory native/v4l2",
    "build:wincam": "node scripts/build-wincam.mjs",
    "build:maccam": "sh native/maccam/build.sh",
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "fixtures:synthetic": "tsx scripts/make-synthetic-fixture.ts",
    "bridge": "node bridge/bin.mjs",
    "agent:catalog": "tsx scripts/agent-catalog.ts",
    "collab:server": "tsx collab/cli.ts",
    "collab:worker": "tsx collab/worker/dev.ts",
    "desktop:build": "vite build && node desktop/build.mjs",
    "desktop": "npm run desktop:build && electron desktop/dist/app",
    "desktop:package": "npm run desktop:build && electron-builder --projectDir desktop --config electron-builder.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "miniflare": "4.20260730.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fflate": "0.8.3",
    "mochi2d": "file:vendor/mochi2d-0.24.1.tgz",
    "qrcode-generator": "2.0.4",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "bin": {
    "mochi-studio-bridge": "bridge/bin.mjs"
  }
}
