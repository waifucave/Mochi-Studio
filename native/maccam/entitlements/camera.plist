<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For the signed build: the Camera Extension, sandboxed as camera extensions
     must be, in the app's group. TEAMID is the Apple team ID. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>TEAMID.com.waifucave.mochistudio</string>
  </array>
</dict>
</plist>
