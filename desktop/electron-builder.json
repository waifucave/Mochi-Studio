{
  "appId": "com.waifucave.mochistudio",
  "productName": "Mochi Studio",
  "directories": {
    "app": "dist/app",
    "output": "dist/release",
    "buildResources": "dist/build"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "package.json",
    "icon.png",
    "web/**/*",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "native/**/*",
    "!node_modules/**"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "asar": true,
  "publish": null,
  "linux": {
    "target": ["dir", "AppImage"],
    "artifactName": "Mochi-Studio-${version}-linux-${arch}.${ext}",
    "icon": "dist/build/icon.png",
    "category": "Video"
  },
  "win": {
    "target": ["zip"],
    "artifactName": "Mochi-Studio-${version}-windows-${arch}.${ext}",
    "icon": "dist/build/icon.png"
  },
  "mac": {
    "target": ["zip"],
    "artifactName": "Mochi-Studio-${version}-macos-${arch}.${ext}",
    "icon": "dist/build/icon.png",
    "identity": null,
    "extendInfo": {
      "NSCameraUsageDescription": "Mochi Studio uses the camera to track your face. Video stays on this computer.",
      "NSMicrophoneUsageDescription": "Mochi Studio uses the microphone for lip sync. Audio stays on this computer."
    },
    "extraFiles": [
      {
        "from": "../native/maccam/build/mochi-camera",
        "to": "MacOS/mochi-camera"
      },
      {
        "from": "../native/maccam/build/com.waifucave.mochistudio.camera.systemextension",
        "to": "Library/SystemExtensions/com.waifucave.mochistudio.camera.systemextension"
      }
    ]
  },
  "asarUnpack": ["native/**"],
  "extraFiles": [
    {
      "from": "dist/app/LICENSE",
      "to": "LICENSE.mochi-studio.txt"
    },
    {
      "from": "dist/app/THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    }
  ]
}
